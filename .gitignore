# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets: never commit keys
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Downloaded source documents and data (rebuilt by the download script; see docs/SOURCES.md)
data/raw/
data/usda/

# Evaluation run reports: model answers and article text (scripts/run_evaluation.py, T6.1)
data/eval_runs/
# DeepEval's cache folder (the eval extra, T9.10): made empty on import; its key file and local
# test-run store would go here, neither of which the scoring uses
.deepeval/

# The capture script's screenshots, frames and GIF (scripts/capture_media.py, T9.27); the chosen
# images are copied into docs/media/ after the owner's review, and T9.28's video stays here too
data/capture/

# Signed-in users' data: the SQLite store (T9.6); never committed
data/store/

# Vector store (rebuilt from the sources)
chroma/
.chroma/

# Generated exports
*.pdf

# Tool caches
.coverage
.pytest_cache/
.ruff_cache/
