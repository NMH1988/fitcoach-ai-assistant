# Copy this file to .streamlit/secrets.toml (gitignored) and paste your key.
# Get a key at https://openrouter.ai/keys. Alternatively, set the
# OPENROUTER_API_KEY environment variable instead of using this file.
# Never commit the real file, and never paste the key into code, issues or PRs.
OPENROUTER_API_KEY = "sk-or-v1-your-key-here"

# Demo mode (optional, T9.5): synthetic users on a temporary database, for trying the coach and
# gymer pages without a Google client. Ignored when an [auth] section exists.
# DEMO_MODE = true

# Sign in with Google (optional, T9.5; README "Sign-in", docs/DEPLOYMENT.md). Commented out, so a
# copy of this file runs for guests (and demo mode) until you set it up: create an OAuth client
# ("Web application") in the Google Cloud console with the redirect URI below, keep the consent
# screen in Testing mode with the openid, email and profile scopes, add the Google accounts that
# may sign in as test users, then remove the "# " in front of the two sections and replace every
# placeholder. The app does not offer sign-in while a secret placeholder is left.
# [auth]
# redirect_uri = "http://localhost:8501/oauth2callback"
# cookie_secret = "replace-with-a-long-random-secret-for-the-cookie"
# client_id = "your-client-id.apps.googleusercontent.com"
# client_secret = "your-client-secret"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
#
# The secret of the keyed hash that turns the Google account's issuer and ID into the app's user
# ID (at least 32 characters, e.g. from `python -c "import secrets; print(secrets.token_hex(32))"`).
# Changing it later gives every user a new, empty account.
# [account]
# user_key_secret = "replace-with-a-long-random-secret-for-user-ids"
